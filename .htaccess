DirectoryIndex index.php
Options -Indexes

<IfModule mod_headers.c>
    Header set X-Robots-Tag "noindex, nofollow, noarchive, nosnippet, noimageindex"
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /notion_scan_business_card/

    # Deny hidden files and directories, while allowing ACME challenges.
    RewriteRule "(^|/)\.(?!well-known(?:/|$))" - [F,L,NC]

    RewriteRule ^(?:app|bootstrap|config|database|node_modules|resources|routes|storage|tests|vendor)(?:/|$) - [F,L,NC]
    RewriteRule ^(?:\.env(?:\..*)?|\.git|\.github)(?:/|$) - [F,L,NC]
    RewriteRule ^(?:artisan|composer\.(?:json|lock)|package(?:-lock)?\.json|phpunit\.xml(?:\.dist)?|vite\.config\.js|README\.md|LICENSE)$ - [F,L,NC]
    RewriteRule ^(?!index\.php$)[^/]+\.php$ - [F,L,NC]
    RewriteRule \.(?:bak|backup|conf|config|dist|ini|log|old|orig|save|sql|sqlite(?:3)?|swp|ya?ml)(?:~)?$ - [F,L,NC]

    RewriteCond %{DOCUMENT_ROOT}/notion_scan_business_card/public/$1 -f [OR]
    RewriteCond %{DOCUMENT_ROOT}/notion_scan_business_card/public/$1 -d
    RewriteRule ^(.+)$ public/$1 [L]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [L,QSA]
</IfModule>

<FilesMatch "(?:^\.|^(?!index\.php$).+\.php$|\.(?:bak|backup|conf|config|dist|ini|log|old|orig|save|sql|sqlite(?:3)?|swp|ya?ml)(?:~)?$|^(?:artisan|composer\.(?:json|lock)|package(?:-lock)?\.json|phpunit\.xml(?:\.dist)?|vite\.config\.js|README\.md|LICENSE)$)">
    Require all denied
</FilesMatch>
